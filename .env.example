# Korail / KTX / ITX-마음 (membership number, phone, or email)
KORAIL_ID=
KORAIL_PW=

# Notify on watch start + kept hold
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Control plane only (Railway service variables, not needed for the local CLI) ---
# Shared secret for the scripted POST/GET/DELETE /jobs API (the web dashboard uses a session cookie instead)
JOB_API_TOKEN=
# Set to 1 only for local http:// testing; cookies are Secure by default
# INSECURE_COOKIES=
# Project token scoped to the environment where sandboxes are created
RAILWAY_TOKEN=
RAILWAY_ENVIRONMENT_ID=
# Checkpoint name produced by scripts/checkpoint.sh (e.g. train-8569514)
WORKER_TEMPLATE=
# Optional: us-west2 | us-east4-eqdc4a | europe-west4-drams3a | asia-southeast1-eqsg3a
WORKER_REGION=
WORKER_IDLE_TIMEOUT_MINUTES=30
