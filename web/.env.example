# Server-only — never expose to the browser
RAILWAY_API_URL=https://api-production-85f7.up.railway.app
RAILWAY_API_KEY=

# Landing gate (case-sensitive)
GATE_PASSCODE=chasehuh
# HMAC secret for unlock cookie (defaults to RAILWAY_API_KEY if unset)
GATE_SECRET=

# Prefer a dedicated secret for encrypted train_rail session cookie
APP_SECRET=

# Dev/smoke only: allow job create without a verified rail session
ALLOW_ENV_CREDS=false

# Train search: TRAIN_SEARCH_MOCK=true forces fixtures.
# Default (unset): try Railway /v1/trains/search, fall back to mock on 404/5xx.
# TRAIN_SEARCH_MOCK=false disables fallback (live-only).
# TRAIN_SEARCH_MOCK=
